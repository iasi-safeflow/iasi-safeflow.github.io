# Copy to .env (git-ignored) and fill in. Never commit real values.
#   Copy-Item .env.example .env

# Signs session tokens. Generate one with:
#   py -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, the server uses a random key per process (everyone is logged out on restart).
SAFEFLOW_SECRET_KEY=

# Demo reviewer account, created at startup if it does not exist. There is no public reviewer sign-up.
DEMO_REVIEWER_EMAIL=reviewer@example.com
DEMO_REVIEWER_PASSWORD=

# Browser origins allowed to call the API (CORS), comma-separated, exact origins only, no wildcard.
# For the GitHub Pages site use https://iasi-safeflow.github.io (origin only, no path)
# Empty = no CORS headers (fine for the phone app, which is not a browser).
SAFEFLOW_ALLOWED_ORIGINS=

# Seed a small labelled "simulated" demo dataset at startup if the database has no reports (1/0).
SAFEFLOW_SEED_DEMO_DATA=1

# Optional
# SAFEFLOW_DB_PATH=backend/safeflow.db
# SAFEFLOW_TOKEN_MAX_AGE=604800
# SAFEFLOW_REPORTS_PER_HOUR=10

# Mobile/web app (put in mobile/.env if the phone cannot reach the PC automatically).
# Read at build time: the GitHub Pages build gets it from the repo variable EXPO_PUBLIC_API_URL.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
