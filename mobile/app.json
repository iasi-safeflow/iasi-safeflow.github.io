{
  "expo": {
    "name": "Iași SafeFlow",
    "slug": "iasi-safeflow",
    "scheme": "iasisafeflow",
    "version": "0.1.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Locația este folosită doar pentru a plasa raportul pe hartă, când alegeți „Folosește GPS”."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b5cad",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.iasisafeflow",
      "versionCode": 5,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Locația este folosită doar pentru a plasa raportul pe hartă, când alegeți „Folosește GPS”."
        }
      ],
      "./plugins/withReleaseSigning",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
